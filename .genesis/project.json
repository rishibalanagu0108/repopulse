  "assumptions": [],
  "invariants": [
    {
      "id": "INVARIANT-59f66a50",
      "text": "GitHub OAuth tokens remain server-side, receive no write permissions, are never logged, and are never exposed to the browser.",
      "source": "SPEC.md",
      "recorded_at": "2026-11-10T09:09:10.327Z",
      "paths": [],
      "tags": []
    }
  ],
  "decisions": [
    {
      "id": "DECISION-34164c15",
      "title": "Use a single Next.js application",
      "text": "Use Next.js App Router with TypeScript for the RepoPulse UI and server routes, PostgreSQL for durable state, and the GitHub REST API as the canonical public repository source. Avoid Redis, queues, schedulers, microservices, and LLM APIs in the first release.",
      "status": "accepted",
      "source": "SPEC.md",
      "recorded_at": "2026-11-10T09:09:10.067Z",
      "paths": [],
      "tags": []
    },
    {
      "id": "DECISION-db93e9f0",
      "title": "Use deterministic repository health scoring",
      "text": "Health scoring must be deterministic, transparent, reproducible from a normalized repository snapshot, and shown with component values and freshness rather than presented as a claim about code quality.",
      "status": "accepted",
      "source": "SPEC.md",
      "recorded_at": "2026-11-10T09:09:10.203Z",
      "paths": [],
      "tags": []
    }
  ],
